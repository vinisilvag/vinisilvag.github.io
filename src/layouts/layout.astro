---
import "../styles/global.css";

const siteUrl = "https://vinisilvag.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL("/avatar.jpg", siteUrl).href;
const description =
  "Computer Scientist and M.Sc. student at Universidade Federal de Minas Gerais (UFMG) researching Formal Methods, Formal Verification, Automated Reasoning, and Satisfiability Modulo Theories (SMT).";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Vinicius Gomes",
  url: siteUrl,
  image: ogImage,
  jobTitle: "Computer Scientist & M.Sc. Student",
  worksFor: {
    "@type": "EducationalOrganization",
    name: "Universidade Federal de Minas Gerais",
    url: "https://ufmg.br/",
  },
  alumniOf: [
    {
      "@type": "EducationalOrganization",
      name: "Universidade Federal de Minas Gerais",
    },
    {
      "@type": "EducationalOrganization",
      name: "Centro Federal de Educação Tecnológica de Minas Gerais",
    },
  ],
  sameAs: [
    "https://github.com/vinisilvag",
    "https://linkedin.com/in/vinisilvag",
    "https://instagram.com/vinisilvag",
    "http://lattes.cnpq.br/9631087254135747",
  ],
  knowsAbout: [
    "Formal Methods",
    "Formal Verification",
    "Automated Reasoning",
    "Satisfiability Modulo Theories (SMT)",
    "Computer Science",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Vinicius Gomes</title>

    <meta name="description" content={description} />
    <meta name="author" content="Vinicius Gomes" />
    <link rel="canonical" href={canonicalUrl} />
    <!-- <link rel="icon" type="image/jpeg" href="/avatar.jpg" /> -->

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Vinicius Gomes" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Vinicius Gomes" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Vinicius Gomes" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content="Vinicius Gomes" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Vinicius Gomes" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (typeof window !== "undefined" && window.matchMedia("(prefers-color-scheme: light)").matches) {
          return "light";
        }
        return "dark";
      })();

      if (theme === "light") {
        document.documentElement.classList.add("light");
        document.documentElement.setAttribute("data-theme", "light");
      } else {
        document.documentElement.classList.remove("light");
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
  </head>
  <body class="bg-background font-sans min-h-screen min-h-dvh flex flex-col text-text">
    <div class="w-full max-w-screen-lg mx-auto py-12 px-6 lg:px-0 flex-1 flex flex-col"> 
      <slot />
    </div>
  </body>
</html>

