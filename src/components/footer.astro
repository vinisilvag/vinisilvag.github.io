---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={["w-full text-center mt-auto", className]}>
  <p class="text-muted">
    <span class="block md:inline">Copyright © <span id="current-year">{new Date().getFullYear()}</span>.</span>{" "}
    <span class="block md:inline">Last updated at Sep 2026.</span>
  </p>
</footer>

<script>
  const yearElement = document.getElementById("current-year");
  if (yearElement) {
    yearElement.textContent = new Date().getFullYear().toString();
  }
</script>
