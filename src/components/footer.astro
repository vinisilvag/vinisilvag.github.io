---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={["w-full text-center mt-auto", className]}>
  <span class="text-muted">
    Copyright © <span id="current-year">{new Date().getFullYear()}</span>. Last update at Sep 2026.
  </span>
</footer>

<script>
  const yearElement = document.getElementById("current-year");
  if (yearElement) {
    yearElement.textContent = new Date().getFullYear().toString();
  }
</script>
