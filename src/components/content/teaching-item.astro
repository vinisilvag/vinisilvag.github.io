---
interface Supervisor {
  name: string;
  url?: string;
}

interface Props {
  title: string;
  course: string;
  period: string;
  supervisor?: string | Supervisor;
  supervisorUrl?: string;
}

const { title, course, period, supervisor, supervisorUrl } = Astro.props;

const supervisorName =
  typeof supervisor === "object" ? supervisor?.name : supervisor;
const supervisorLink =
  typeof supervisor === "object" ? supervisor?.url : supervisorUrl;
---

<div class="flex flex-col w-full">
  <h3 class="text-heading text-lg font-semibold">{title}</h3>
  <span class="text-text text-sm">{course}</span>
  {supervisorName && (
    <span class="text-muted text-sm">
      Supervised by{" "}
      {supervisorLink ? (
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={supervisorLink}
          class="text-link font-medium hover:underline underline-offset-2 transition-colors"
        >
          {supervisorName}
        </a>
      ) : (
        <span class="text-text">{supervisorName}</span>
      )}
    </span>
  )}
  <span class="text-muted text-sm font-mono">{period}</span>
</div>
