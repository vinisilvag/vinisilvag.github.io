---
interface Props {
  title: string;
  event?: string;
  description?: string;
  authors?: string | string[];
  poster?: string | null;
  pdf?: string | null;
}

const { title, event, description, authors, poster, pdf } = Astro.props;
const eventText = event || description;
const posterLink = poster || pdf;
const posterLabel = poster ? "[poster]" : "[pdf]";
const authorsText = Array.isArray(authors) ? authors.join(", ") : authors;
---

<div class="flex flex-col w-full">
  <h3 class="text-heading text-md leading-snug font-semibold">{title}</h3>
  {authorsText && <span class="text-text text-sm" set:html={authorsText} />}
  {eventText && <span class="text-muted text-sm">{eventText}</span>}
  {posterLink && (
    <a
      href={posterLink}
      target="_blank"
      rel="noopener noreferrer"
      class="text-link hover:underline font-mono font-medium w-fit text-sm mt-0.5"
    >
      {posterLabel}
    </a>
  )}
</div>
